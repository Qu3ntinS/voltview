{
  "name": "voltview",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && bun scripts/seo-static.ts",
    "build:pages": "VITE_STATIC=1 vite build && bun scripts/seo-static.ts",
    "build:vercel": "VITE_STATIC=1 VITE_BASE=/ bun scripts/build-vercel.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/static": "^1.4.0",
    "elysia": "^1.4.6",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.4.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
